{
  "view_id": "ios_008",
  "platform": "iOS",
  "view_name": "Mortgage Calculator Form",
  "function": "Collect basic user financial inputs for indicative affordability simulation.",
  "visual_goal": "Trustworthy, simple, private, non-banking interface.",
  "layout": {
    "background": "#F7F4ED",
    "scroll": "vertical",
    "sections": [
      "intro",
      "form_fields",
      "privacy_note",
