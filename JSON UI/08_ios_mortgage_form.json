  "components": {
    "input": {
      "height": 52,
      "radius": 14,
      "background": "#FFFFFF",
      "border": "#D8D2C4"
    },
    "button": {
      "type": "button",
      "label": "Calcola possibilità",
      "height": 50,
      "radius": 14,
      "background": "#556B45",
      "text_color": "#FFFFFF",
      "font": "16 semibold",
      "interaction": "tap"
    },
    "privacy_note": {
      "icon": "lock",
      "text": "I tuoi dati sono al sicuro e riservati.",
      "font_size": 12
    }
  },
  "do_not": [
    "Do not imply bank approval.",
    "Do not ask too many personal questions in MVP."
  ]
