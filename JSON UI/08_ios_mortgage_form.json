    ]
  },
  "fields": [
    {
      "name": "monthly_income",
      "label": "Reddito mensile netto",
      "example": "€ 3.500"
    },
    {
      "name": "deposit",
      "label": "Anticipo disponibile",
      "example": "€ 160.000"
    },
    {
      "name": "mortgage_years",
      "label": "Durata mutuo",
      "example": "25 anni"
    },
    {
      "name": "existing_debts",
      "label": "Altri impegni mensili",
      "example": "€ 250"
    },
    {
      "name": "age",
      "label": "Età",
      "example": "38 anni"
    },
    {
      "name": "first_home",
      "label": "Prima casa",
      "example": "Sì"
    }
