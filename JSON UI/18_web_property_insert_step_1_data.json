{
  "view_id": "web_004",
  "platform": "Next.js Desktop",
  "view_name": "Property Insert Wizard — Step 1 Data",
  "function": "Insert main property information in a guided, readable workflow.",
  "visual_goal": "Simple form, live preview, not a wall of fields.",
  "layout": {
    "background": "#F7F4ED",
    "sidebar": "standard_admin_sidebar",
    "content": {
      "top": [
        "breadcrumb",
        "save_draft",
        "continue"
      ],
      "wizard_steps": [
        "1 Dati immobile",
        "2 Media e planimetrie",
        "3 Dettagli tecnici",
        "4 Documenti",
        "5 Pubblicazione"
      ],
      "main": "two_columns",
      "left_column": "form",
      "right_column": "preview_card"
    }
  },
  "fields": [
    "Tipologia",
    "Contratto",
    "Titolo annuncio",
    "Prezzo",
    "Comune",
    "Zona",
    "Indirizzo",
    "Mq",
    "Camere",
    "Bagni",
    "Classe energetica"
  ],
  "components": {
    "form_card": {
      "background": "#FFFFFF",
      "radius": 20,
      "padding": 24
    },
    "input": {
      "height": 46,
      "radius": 10,
      "border": "#D8D2C4"
    },
    "preview_card": {
      "background": "#FFFFFF",
      "radius": 20,
      "image_ratio": "16:10",
      "fields": [
        "image",
        "price",
        "title",
        "main_specs"
      ]
    },
    "continue_button": {
      "type": "button",
      "label": "Continua",
      "height": 50,
      "radius": 14,
      "background": "#556B45",
      "text_color": "#FFFFFF",
      "font": "16 semibold",
      "interaction": "tap"
    }
  },
  "do_not": [
    "Do not show media upload on this step.",
    "Do not show cadastral data here.",
    "Do not make the form full width with no preview."
  ]
}