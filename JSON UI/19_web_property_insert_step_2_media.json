{
  "view_id": "web_005",
  "platform": "Next.js Desktop",
  "view_name": "Property Insert Wizard — Step 2 Media",
  "function": "Upload and organize photos, planimetry, documents and 3D preview assets.",
  "visual_goal": "Media management clear enough for non-technical agency users.",
  "layout": {
    "background": "#F7F4ED",
    "content": {
      "top": [
        "wizard_steps",
        "save_draft",
        "preview_ad"
      ],
      "main_grid": [
        "photo_gallery",
        "floorplan_upload",
        "documents_summary",
        "publishing_preview"
      ]
    }
  },
  "components": {
    "photo_gallery": {
      "background": "#FFFFFF",
      "radius": 20,
      "grid": "3 columns",
      "dropzone": true,
      "cover_selection": true
    },
    "floorplan_upload": {
      "background": "#FFFFFF",
      "radius": 20,
      "supports": [
        "2D plan",
        "3D preview static image"
      ]
    },
    "documents_summary": {
      "files": [
        "APE.pdf",
        "Visura catastale.pdf",
        "Planimetria PDF.pdf"
      ],
      "visibility": "private_by_default"
    },
    "preview_button": {
      "type": "button",
      "label": "Anteprima annuncio",
      "height": 48,
      "radius": 14,
      "background": "#FFFFFF",
      "border": "#D8D2C4",
      "text_color": "#243526",
      "font": "16 medium",
      "interaction": "tap"
    },
    "publish_button": {
      "type": "button",
      "label": "Pubblica annuncio",
      "height": 50,
      "radius": 14,
      "background": "#556B45",
      "text_color": "#FFFFFF",
      "font": "16 semibold",
      "interaction": "tap"
    }
  },
  "do_not": [
    "Do not mix private documents with public gallery.",
    "Do not use tiny image thumbnails.",
    "Do not publish documents by default."
  ]
}