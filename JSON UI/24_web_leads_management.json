{
  "view_id": "web_010",
  "platform": "Next.js Desktop",
  "view_name": "Leads Management",
  "function": "Manage leads generated by property detail, mortgage, renovation and visit requests.",
  "visual_goal": "Sales workflow, simple and actionable.",
  "layout": {
    "background": "#F7F4ED",
    "sections": [
      "lead_status_filters",
      "lead_list",
      "lead_detail_panel"
    ]
  },
  "components": {
    "filters": [
      "Nuovi",
      "Contattati",
      "Visita fissata",
      "Qualificati",
      "Persi",
      "Convertiti"
    ],
    "lead_card": {
      "height": 96,
      "background": "#FFFFFF",
      "radius": 18,
      "fields": [
        "name",
        "property",
        "source",
        "date",
        "status"
      ]
    },
    "detail_panel": {
      "background": "#FFFFFF",
      "radius": 24,
      "includes": [
        "contact_info",
        "property_interest",
        "notes",
        "status_update"
      ]
    }
  },
  "sources": [
    "visit_request",
    "mortgage_calculator",
    "renovation_estimate",
    "contact_form",
    "whatsapp_click",
    "phone_click"
  ],
  "do_not": [
    "Do not show sensitive mortgage fields in list view.",
    "Do not overload lead cards."
  ]
}